CREATE DATABASE audit_system;
USE audit_system;

--- create table employee---
CREATE TABLE employees (
    emp_id INT PRIMARY KEY,
    name VARCHAR(50),
    salary INT
);

---create Log table---
CREATE TABLE employee_log (
    log_id INT AUTO_INCREMENT PRIMARY KEY,
    emp_id INT,
    action_type VARCHAR(20),
    action_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

---Trigger for INSERT---
DELIMITER //

CREATE TRIGGER after_insert_employee
AFTER INSERT ON employees
FOR EACH ROW
BEGIN
    INSERT INTO employee_log(emp_id, action_type)
    VALUES (NEW.emp_id, 'INSERT');
END;
//

DELIMITER ;
---Trigger for UPDATE---
DELIMITER //

CREATE TRIGGER after_update_employee
AFTER UPDATE ON employees
FOR EACH ROW
BEGIN
    INSERT INTO employee_log(emp_id, action_type)
    VALUES (NEW.emp_id, 'UPDATE');
END;
//

DELIMITER ;


INSERT INTO employees VALUES (1, 'Mani', 30000);
UPDATE employees SET salary = 35000 WHERE emp_id = 1;
SELECT * FROM employee_log;

---Create view daily_activity ---
CREATE VIEW daily_activity AS
SELECT 
    DATE(action_time) AS date,
    action_type,
    COUNT(*) AS total_actions
FROM employee_log
GROUP BY DATE(action_time), action_type;

SELECT * FROM daily_activity;